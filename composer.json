{
  "name": "thebigcrafter/commando",
  "description": "A command framework virion for PocketMine-MP",
  "type": "library",
  "license": "LGPL-3.0-only",
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "pocketmine/pocketmine-mp": "^5.44.3"
  },
  "autoload": {
    "psr-4": {
      "CortexPE\\Commando\\": "src/CortexPE/Commando/"
    }
  },
  "scripts": {
    "analyze": "phpstan analyse --configuration=phpstan.neon.dist --no-progress"
  },
  "extra": {
    "virion": {
      "spec": "3.1",
      "namespace-root": "CortexPE\\Commando"
    }
  }
}
